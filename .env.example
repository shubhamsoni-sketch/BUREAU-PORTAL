# Copy to .env for local development and fill in real values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API Hub live gateway. Sandbox works without these values.
API_HUB_GATEWAY_URL=
API_HUB_GATEWAY_TOKEN=
API_HUB_GATEWAY_AUTH_HEADER=token
API_HUB_GATEWAY_TIMEOUT_MS=45000

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ADSENSE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# WhatsApp Cloud API
# Create these in Meta Developer / WhatsApp Manager. Keep the access token secret.
WHATSAPP_API_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_PROMOTION_SEND_LIMIT=50

# Optional approved template names. If blank, WhatsApp auto-send is skipped.
WHATSAPP_DEMO_THANK_YOU_TEMPLATE=
WHATSAPP_PARTNER_ENQUIRY_TEMPLATE=
WHATSAPP_PARTNER_WELCOME_TEMPLATE=
