# WhatsApp Cloud API
# Create these in Meta Developer / WhatsApp Manager. Keep the access token secret.
WHATSAPP_API_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=1410697734305817
WHATSAPP_AD_ENQUIRY_NUMBER=8109276589
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_PROMOTION_SEND_LIMIT=50
WHATSAPP_TRACKING_BASE_URL=https://credittrust.in

# Optional approved template names. If blank, WhatsApp auto-send is skipped.
WHATSAPP_DEMO_THANK_YOU_TEMPLATE=
WHATSAPP_PARTNER_ENQUIRY_TEMPLATE=
WHATSAPP_PARTNER_WELCOME_TEMPLATE=

# B2C WhatsApp OTP. Create and approve an Authentication template in Meta.
# The template must contain one body variable and a Copy Code button.
WHATSAPP_B2C_OTP_TEMPLATE=credittrust_report_otp
WHATSAPP_B2C_OTP_LANGUAGE=en
WHATSAPP_B2C_OTP_BUTTON_TYPE=copy_code

# B2C report-ready Utility template. Use a URL button like https://credittrust.in/r/{{1}}.
# Body placeholders are optional and pipe-separated, for example: {name}|{report_id}
WHATSAPP_B2C_REPORT_READY_TEMPLATE=
WHATSAPP_B2C_REPORT_READY_LANGUAGE=en
WHATSAPP_B2C_REPORT_READY_BODY_VALUES=
WHATSAPP_B2C_REPORT_READY_URL_BUTTON_MODE=token

