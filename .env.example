# Copy to .env for local development and fill in real values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API Hub live gateway. Sandbox works without these values.
API_HUB_GATEWAY_URL=
API_HUB_GATEWAY_TOKEN=
API_HUB_GATEWAY_AUTH_HEADER=token
API_HUB_GATEWAY_TIMEOUT_MS=45000

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ADSENSE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# WhatsApp Cloud API
# Create these in Meta Developer / WhatsApp Manager. Keep the access token secret.
WHATSAPP_API_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_PROMOTION_SEND_LIMIT=50
WHATSAPP_TRACKING_BASE_URL=https://credittrust.in

# Optional approved template names. If blank, WhatsApp auto-send is skipped.
WHATSAPP_DEMO_THANK_YOU_TEMPLATE=
WHATSAPP_PARTNER_ENQUIRY_TEMPLATE=
WHATSAPP_PARTNER_WELCOME_TEMPLATE=

# B2C WhatsApp OTP. Create and approve an Authentication template in Meta.
# The template must contain one body variable and a Copy Code button.
WHATSAPP_B2C_OTP_TEMPLATE=credittrust_report_otp
WHATSAPP_B2C_OTP_LANGUAGE=en
WHATSAPP_B2C_OTP_BUTTON_TYPE=copy_code

# B2C report-ready Utility template. Use a URL button like https://credittrust.in/r/{{1}}.
# Body placeholders are optional and pipe-separated, for example: {name}|{report_id}
WHATSAPP_B2C_REPORT_READY_TEMPLATE=
WHATSAPP_B2C_REPORT_READY_LANGUAGE=en
WHATSAPP_B2C_REPORT_READY_BODY_VALUES=
WHATSAPP_B2C_REPORT_READY_URL_BUTTON_MODE=token

# Meta Marketing Automation
# Store real tokens only in Vercel/Supabase secrets, never in frontend code.
META_GRAPH_API_VERSION=v23.0
META_ACCESS_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_REQUIRE_SIGNATURE=false
META_BUSINESS_ID=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_INSTAGRAM_USER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_DISPLAY_NUMBER=8109276589
META_SPECIAL_AD_CATEGORIES=CREDIT
MARKETING_CRON_SECRET=
CRON_SECRET=

# B2C paid financial-report flow
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=production
CASHFREE_API_VERSION=2025-01-01
B2C_REPORT_PRICE=199
NEXT_PUBLIC_B2C_REPORT_PRICE=199
B2C_SESSION_SECRET=
