# Prepare separately. Do not enable until DNS, HTTPS server cert, client trust,
# fingerprint allowlist, backend attestation and end-to-end tests are complete.
server {
    listen 443 ssl;
    server_name secure-api.credittrust.in;

    ssl_certificate /etc/letsencrypt/live/secure-api.credittrust.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/secure-api.credittrust.in/privkey.pem;
    ssl_client_certificate /etc/credittrust/secure-api/client-trust-bundle.pem;
    ssl_verify_client on;
    ssl_verify_depth 2;

    client_max_body_size 1m;
    location = /api/v1/source {
        proxy_pass http://127.0.0.1:9443;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Client-Verify $ssl_client_verify;
        proxy_set_header X-Verified-Client-Cert $ssl_client_escaped_cert;
        proxy_set_header X-Verified-Source-IP $remote_addr;
        proxy_set_header X-CreditTrust-Edge-Token REPLACE_WITH_EDGE_INGRESS_TOKEN;
        proxy_set_header X-CreditTrust-Mtls-Fingerprint "";
        proxy_set_header X-CreditTrust-Mtls-Source-IP "";
        proxy_set_header X-CreditTrust-Mtls-Timestamp "";
        proxy_set_header X-CreditTrust-Mtls-Signature "";
        proxy_read_timeout 70s;
    }

    location / { return 404; }
}
