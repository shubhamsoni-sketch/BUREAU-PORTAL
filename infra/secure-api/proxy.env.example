# Install as /etc/credittrust/secure-api/proxy.env with owner root and mode 0600.
# Never commit filled values. The signing secret must match the app setting.
PORT=9443
UPSTREAM_URL=https://api.credittrust.in/api/v1/source
MTLS_PROXY_SECRET=CHANGE_ME
EDGE_INGRESS_SECRET=CHANGE_ME
ALLOWED_CERT_SHA256=CHANGE_ME
